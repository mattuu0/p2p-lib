# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/

# Native library built from ../../tailcat-cgo by the podspecs'
# prepare_command / src/CMakeLists.txt -- never commit these, they're
# rebuilt from Go source on every `pod install` / native build.
ios/libtailcat_cgo*.a
ios/libtailcat_cgo*.h
macos/libtailcat_cgo*.dylib
macos/libtailcat_cgo*.h
.flutter-plugins-dependencies
/build/
/coverage/
